<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WriteJournal"
    android:background="@color/softpinkwhitebackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="8dp"
        android:background="@color/softpinkwhitebackground"
        android:elevation="4dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/titleToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/softpinkwhitebackground"
            android:fontFamily="@font/opensans"
            android:inputType="text"
            android:hint="@string/untitled"
            android:textColorHint="@color/black"
            android:textColor="@color/black" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/llDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/writeJournalDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_day"
            android:fontFamily="@font/inika_regular"
            android:textSize="16sp"
            android:textColor="@color/black"/>
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/writeJournalDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/write_journal_date"
            android:fontFamily="@font/inika_regular"
            android:textColor="@color/black"
            android:textSize="16sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/llDate"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/uploadContainer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/custom_upload_container">
                
                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:scaleType="centerCrop"/>
                <ImageView
                    android:id="@+id/imgPlusIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/plus_two_toned"/>

                <ImageView
                    android:id="@+id/btnDeleteImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/icon_cross"
                    android:layout_gravity="top|end"
                    android:visibility="gone"/>

            </FrameLayout>

            <EditText
                android:id="@+id/edtJournalContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:background="@color/softpinkwhitebackground"
                android:fontFamily="@font/opensans"
                android:gravity="top"
                android:hint="@string/write_journal_entry_hint"
                android:inputType="textMultiLine"
                android:minHeight="200dp"
                android:padding="4dp"
                android:textColor="@color/black" />

        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>