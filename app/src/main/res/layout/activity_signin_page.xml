<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SigninPage"
    android:background="@color/softpinkwhitebackground">

    <ImageView
        android:id="@+id/imageSignin"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/loginphoto"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/signinText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signin_intro_text"
        android:fontFamily="@font/opensans"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:layout_marginTop="60dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/imageSignin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvUserNameSignIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_username"
        android:fontFamily="@font/inika_regular"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signinText"/>

    <EditText
        android:id="@+id/edtSignInUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@drawable/custom_background_edittext"
        android:hint="@string/username_hint_text"
        android:textColorHint="@color/grey"
        android:textColor="@color/black"
        android:fontFamily="@font/opensans"
        android:drawableStart="@drawable/icon_profile"
        android:inputType="textPersonName"
        android:drawablePadding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/tvUserNameSignIn"/>

    <TextView
        android:id="@+id/tvPasswordSignIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/register_password"
        android:fontFamily="@font/inika_regular"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtSignInUsername"/>

    <EditText
        android:id="@+id/edtSignInPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@drawable/custom_background_edittext"
        android:hint="@string/password_hint_text"
        android:textColorHint="@color/grey"
        android:textColor="@color/black"
        android:fontFamily="@font/opensans"
        android:drawableStart="@drawable/icon_profile"
        android:inputType="textPersonName"
        android:drawablePadding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/tvPasswordSignIn"/>


    <TextView
        android:id="@+id/txtForgetPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forget_password_text"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/opensans"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@id/edtSignInPassword"
        app:layout_constraintTop_toBottomOf="@id/edtSignInPassword"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:text="@string/sign_in_text"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/opensans"
        android:textStyle="bold"
        android:backgroundTint="@color/softcoral"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/edtSignInPassword"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        app:strokeColor="@color/softcoral"
        app:strokeWidth="1dp"
        android:backgroundTint="@color/white"
        android:drawableLeft="@drawable/google_logo"
        android:text="Sign in with Google"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:fontFamily="@font/opensans"
        app:rippleColor="@color/softcoral"
        android:drawablePadding="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnSignin"/>

    <LinearLayout
        android:id="@+id/textNewToRadiate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:weightSum="3"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/btnGoogleSignIn">

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/grey"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtNewToRadiate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/register_text"
            android:textSize="12sp"
            android:fontFamily="@font/opensans"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_weight="1"/>

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/grey"
            android:layout_weight="1"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegisterHere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="48dp"
        android:text="@string/register_button_text"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/opensans"
        android:backgroundTint="@color/pastelyellow"
        app:strokeWidth="1dp"
        app:strokeColor="@color/softcoral"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/textNewToRadiate"/>

</androidx.constraintlayout.widget.ConstraintLayout>