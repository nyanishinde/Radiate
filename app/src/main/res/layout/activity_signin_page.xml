<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SigninPage"
    android:background="@color/softpinkwhitebackground">

    <ImageView
        android:id="@+id/imageSignin"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/loginphoto"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/signinText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/signin_intro_text"
        android:fontFamily="@font/opensans"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="80dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/imageSignin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/usernameLayoutSignin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@color/pastelyellow"
        app:boxCornerRadiusBottomStart="30dp"
        app:boxCornerRadiusBottomEnd="30dp"
        app:boxCornerRadiusTopEnd="30dp"
        app:boxCornerRadiusTopStart="30dp"
        app:boxStrokeWidth="2dp"
        app:boxStrokeColor="@color/softcoral"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/signinText">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/usernameSignin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/icon_profile"
            android:drawablePadding="8dp"
            android:textSize="16sp"
            android:hint="@string/username_hint_text"
            android:textColorHint="@color/grey"
            android:inputType="textEmailAddress"
            android:textColor="@color/black"
            android:fontFamily="@font/opensans"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordSigninLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@color/pastelyellow"
        app:boxCornerRadiusBottomStart="30dp"
        app:boxCornerRadiusBottomEnd="30dp"
        app:boxCornerRadiusTopEnd="30dp"
        app:boxCornerRadiusTopStart="30dp"
        app:boxStrokeWidth="2dp"
        app:boxStrokeColor="@color/softcoral"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/usernameLayoutSignin">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/passwordSignin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/icon_lock"
            android:drawablePadding="8dp"
            android:textSize="16sp"
            android:hint="@string/password_hint_text"
            android:textColorHint="@color/grey"
            android:inputType="textEmailAddress"
            android:textColor="@color/black"
            android:fontFamily="@font/opensans"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forget_password_text"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/opensans"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@id/passwordSigninLayout"
        app:layout_constraintTop_toBottomOf="@id/passwordSigninLayout"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sign_in_text"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/opensans"
        android:textStyle="bold"
        android:backgroundTint="@color/softcoral"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey"
        android:minHeight="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/passwordSigninLayout"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:strokeColor="@color/softcoral"
        app:strokeWidth="2dp"
        android:backgroundTint="@color/white"
        android:drawableLeft="@drawable/google_logo"
        android:text="Sign in with Google"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:drawablePadding="8dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btnSignin"/>


</androidx.constraintlayout.widget.ConstraintLayout>