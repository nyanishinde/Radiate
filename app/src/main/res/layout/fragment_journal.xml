<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".JournalFragment"
    android:backgroundTint="@color/softpinkwhitebackground">

    <LinearLayout
        android:id="@+id/llActionBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/pastelyellow"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgJournlaProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/profile_avatar"
            android:layout_marginStart="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/journal_greetings"
            android:textColor="@color/black"
            android:fontFamily="@font/opensans"
            android:layout_marginStart="8dp"/>

<!-- Add options menu here       -->

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDateAndSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:minHeight="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llActionBar">

        <TextView
            android:id="@+id/tvDateJournal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/journal_display_date"
            android:textSize="16sp"
            android:fontFamily="@font/opensans"
            android:layout_weight="1"/>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/black"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            >
            <ImageView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_sort"
                android:maxHeight="20dp"
                android:minWidth="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort"
                android:fontFamily="@font/opensans"
                android:textColor="@color/black"
                android:paddingStart="4dp"/>
        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/listitem_journal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/llDateAndSort"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>